<rx:ReactiveWindow x:Class="CPDeploymentStudio.Reactive.Example.InstallerWindow"
                   x:TypeArguments="local:InstallerViewModel"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:rx="clr-namespace:ReactiveUI.Reactive;assembly=ReactiveUI.Wpf.Reactive"
                   xmlns:local="clr-namespace:CPDeploymentStudio.Reactive.Example"
                   mc:Ignorable="d"
                   Title="Deployment Studio · ReactiveUI 24"
                   Width="1480"
                   Height="900"
                   MinWidth="1160"
                   MinHeight="720"
                   WindowStartupLocation="CenterScreen"
                   Background="#0B1020">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141C2E" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#19243A" />
        <SolidColorBrush x:Key="BorderBrush" Color="#293752" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EDF7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4BF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5AE0C0" />
        <SolidColorBrush x:Key="BlueBrush" Color="#6AA9FF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F6C85F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF758F" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0E1628" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#101728" />
            <Setter Property="Background" Value="#ECF3FF" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#07141C" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#253652" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#A93B58" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" Background="#10182B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#234B55" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="DRY RUN" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="DEPLOYMENT STUDIO" FontWeight="Bold" FontSize="20" />
                        <TextBlock Text="  /  ReactiveUI 24 .Reactive + CP Windows Primitives.Reactive" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Headline}" FontSize="25" FontWeight="Light" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Inspect workstation" Command="{Binding InspectEnvironment}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Run simulation" Command="{Binding RunWorkflow}" />
                    <Button Content="Cancel" Command="{Binding CancelWorkflow}" Style="{StaticResource DangerButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="410" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Deployment plan" Style="{StaticResource SectionTitle}" />
                            <Label Content="PACKAGE OR PAYLOAD" />
                            <TextBox Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                <Button Content="Browse…" Command="{Binding BrowsePackage}" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Reveal" Command="{Binding RevealPackage}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>

                            <Label Content="PROPOSED INSTALL ROOT" />
                            <TextBox Text="{Binding InstallRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="ENVIRONMENT" />
                                    <ComboBox SelectedValue="{Binding EnvironmentName}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="Development" />
                                        <ComboBoxItem Content="Staging" />
                                        <ComboBoxItem Content="Production" IsSelected="True" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="CHANNEL" />
                                    <ComboBox SelectedValue="{Binding ReleaseChannel}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="Stable" IsSelected="True" />
                                        <ComboBoxItem Content="Preview" />
                                        <ComboBoxItem Content="Internal" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Plan a per-user Start menu shortcut" IsChecked="{Binding CreateStartMenuShortcut}" />
                            <CheckBox Content="Plan a user PATH update" IsChecked="{Binding UpdateUserPath}" />
                            <CheckBox Content="Dry-run safety lock (always enforced)" IsChecked="{Binding DryRun}" IsEnabled="False" />
                            <CheckBox Content="I understand this is a simulation only" IsChecked="{Binding AcceptSimulation}" />

                            <Border Background="#0E1628" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlanIsValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Content="Rebuild plan" Command="{Binding RefreshPlan}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Safety contract" Style="{StaticResource SectionTitle}" />
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"
                                       Text="The workflow reads Windows inventory, validates paths, queries Restart Manager, opens optional shell UI, and runs a read-only version probe. File copy, registry writes, environment mutation, elevation, shutdown and restart are intentionally not implemented." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Workflow progress" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#0E1628" />
                        <TextBlock Text="{Binding CurrentStage.Detail}" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <Border Background="#0E1628" CornerRadius="4" Padding="8" Margin="0,9,0,0">
                            <TextBlock x:Name="EventStreamText" Text="Waiting for the typed deployment event stream…" Foreground="{StaticResource BlueBrush}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="170" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Six-stage deployment pipeline" Style="{StaticResource SectionTitle}" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F182A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="12" Height="12">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#53627A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Fill" Value="{StaticResource BlueBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Complete"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="Generated operations" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                        <DataGrid Grid.Row="3" ItemsSource="{Binding PlannedOperations}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" Background="#0F182A" Foreground="{StaticResource TextBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" RowBackground="#0F182A" AlternatingRowBackground="#121E33">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="AREA" Binding="{Binding Category}" Width="90" />
                                <DataGridTextColumn Header="OPERATION" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="MODE" Binding="{Binding Disposition}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Environment &amp; elevation" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding InspectEnvironment}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,0,8" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding EnvironmentFacts}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Diagnostics &amp; command errors" Style="{StaticResource SectionTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Run probe" Command="{Binding RunReadOnlyProbe}" Style="{StaticResource SecondaryButton}" Padding="10,5" />
                                <Button Content="Clear" Command="{Binding ClearDiagnostics}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="#351824" BorderBrush="#7C3048" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,9">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Diagnostics}" Background="#0E1628" BorderBrush="{StaticResource BorderBrush}" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#24334D" BorderThickness="0,0,0,1" Padding="7">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#10182B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SYSTEM.REACTIVE API SURFACE  ·  Core native identity + Restart Manager  ·  Reactive Windows software + shell dialogs  ·  Rx observable streams  ·  Integrations browser inventory" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="ZERO-DESTRUCTIVE-CHANGE GUARANTEE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</rx:ReactiveWindow>
