<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Foundational Windows primitives, native interop, safe handles, registry monitoring, COM contracts, and graphics infrastructure.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>windows native interop primitives</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>$(WindowsPackageTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <PackageReference Include="log4net" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
    <PackageReference Include="ReactiveUI.Primitives" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Diagnostics.Contracts" />
    <Using Include="System.Globalization" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Numerics" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Text" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="log4net" />
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Concurrency" />
    <Using Include="ReactiveUI.Primitives.Disposables" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Internal" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface.SafeHandles" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Messaging.Enumerations" />
    <Using Include="System.Runtime.InteropServices.ComTypes.DISPPARAMS" Alias="DISPPARAMS" />
    <Using Include="System.Runtime.InteropServices.ComTypes.EXCEPINFO" Alias="EXCEPINFO" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Gdi.Structs.GdiBitmap" Alias="GdiBitmap" />
  </ItemGroup>
</Project>
