<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <RootNamespace>CP.ReactiveUI.Primitives.Windows.Reactive.Example.FormsExample</RootNamespace>
    <AssemblyName>CP.ReactiveUI.Primitives.Windows.Reactive.Example.FormsExample</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CP.ReactiveUI.Primitives.Windows.Core\CP.ReactiveUI.Primitives.Windows.Core.csproj" />
    <ProjectReference Include="..\CP.ReactiveUI.Primitives.Windows.Reactive\CP.ReactiveUI.Primitives.Windows.Reactive.csproj" />
    <ProjectReference Include="..\CP.ReactiveUI.Primitives.Windows.Integrations\CP.ReactiveUI.Primitives.Windows.Integrations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI.Reactive" />
    <PackageReference Include="ReactiveUI.WinForms.Reactive" />
    <PackageReference Include="System.Resources.Extensions" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>
</Project>