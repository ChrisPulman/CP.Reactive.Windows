<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>System.Reactive-flavoured build of the composable Windows desktop capabilities.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>windows desktop observable reactive system.reactive</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>$(WindowsPackageTargetFrameworks)</TargetFrameworks>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>CP.ReactiveUI.Primitives.Windows.Reactive</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CP.ReactiveUI.Primitives.Windows.Core\CP.ReactiveUI.Primitives.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\CP.ReactiveUI.Primitives.Windows\.codex-diagnostics\**\*.cs" />
    <Compile Remove="..\CP.ReactiveUI.Primitives.Windows\.codex-recovery\**\*.cs" />
    <Compile Include="..\CP.ReactiveUI.Primitives.Windows\**\*.cs"
             Exclude="..\CP.ReactiveUI.Primitives.Windows\bin\**;..\CP.ReactiveUI.Primitives.Windows\obj\**;..\CP.ReactiveUI.Primitives.Windows\.codex-diagnostics\**;..\CP.ReactiveUI.Primitives.Windows\.codex-recovery\**"
             LinkBase="Shared" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <PackageReference Include="log4net" />
    <PackageReference Include="ReactiveUI.Primitives.Reactive" />
    <PackageReference Include="System.ComponentModel.Annotations" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Drawing" />
    <Using Include="System.Drawing.Imaging" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Runtime.InteropServices.Marshalling.GeneratedComInterfaceAttribute" Alias="GeneratedComInterface" Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Text" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="log4net" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Apps" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Clipboard.Internals" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Composition" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Composition.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Composition.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Devices.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Devices.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Display" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Display.Dpi" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Display.Dpi.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input.Keyboard" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input.Mouse" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Lifecycle.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Media.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Messaging" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Messaging.Enumerations" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Messaging.Native" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Messaging.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Power.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Shell.Dialogs.Interop" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Shell.Icons.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Shell.Icons.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Windows" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Windows.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Extensions" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Gdi" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Gdi.SafeHandles" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Kernel" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface.Structs" />
    <Using Include="ReactiveUI.Primitives.Disposables" />
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals.Signal" Alias="ReactiveSignal" />
    <Using Include="System.Reactive.Unit" Alias="RxVoid" />
    <Using Include="System.Reactive.Concurrency.IScheduler" Alias="ISequencer" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Input.Structs.Input" Alias="DesktopInput" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Native.UserInterface" Alias="User32" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Reactive.Desktop.Clipboard.Internals.NativeMethods" Alias="ClipboardNativeMethods" />
    <Using Include="System.Windows.Media.Color" Alias="MediaColor" />
    <Using Include="System.Drawing.Color" Alias="DrawingColor" />
  </ItemGroup>
</Project>
