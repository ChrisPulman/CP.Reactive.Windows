    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Power.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Shell.Dialogs.Interop" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Shell.Icons.Enums" />
