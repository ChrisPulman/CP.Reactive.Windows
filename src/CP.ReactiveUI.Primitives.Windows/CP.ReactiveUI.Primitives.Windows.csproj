    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Composition.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Devices.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Devices.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Display" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Display.Dpi" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Display.Dpi.Enums" />
