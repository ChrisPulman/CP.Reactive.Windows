<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Composable Windows desktop capabilities with observable messages, input, device, clipboard, display, power, and lifecycle state.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>windows desktop observable reactive</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>$(WindowsPackageTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>CP.ReactiveUI.Primitives.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CP.ReactiveUI.Primitives.Windows.Core\CP.ReactiveUI.Primitives.Windows.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove=".codex-diagnostics\**\*.cs;.codex-recovery\**\*.cs" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <PackageReference Include="log4net" />
    <PackageReference Include="ReactiveUI.Primitives" />
    <PackageReference Include="System.ComponentModel.Annotations" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.ComponentModel" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Drawing" />
    <Using Include="System.Drawing.Imaging" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Runtime.InteropServices.Marshalling.GeneratedComInterfaceAttribute" Alias="GeneratedComInterface" Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'" />
    <Using Include="System.Text" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="log4net" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Apps" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Clipboard.Internals" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Composition" />
