    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Input.Structs" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Lifecycle.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Media.Enums" />
    <Using Include="CP.ReactiveUI.Primitives.Windows.Desktop.Messaging" />
