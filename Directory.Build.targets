<Project>
  <Target Name="ValidateNonEmptyCompileSources"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <GetFileHash Files="@(Compile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CompileSourceHashes" />
    </GetFileHash>

    <Error Condition="'%(_CompileSourceHashes.FileHash)' == 'E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855'"
           Text="Compile source '%(_CompileSourceHashes.Identity)' is empty. Restore it from Git before building." />
  </Target>
</Project>
