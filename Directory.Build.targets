<Project>
  <Target Name="ValidateRepositorySourceIntegrity"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectName)' == 'CP.ReactiveUI.Primitives.Windows.Core' And '$(TargetFramework)' == 'net462'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)tools\Validate-SourceIntegrity.ps1&quot; -RepositoryRoot &quot;$(MSBuildThisFileDirectory).&quot;" />
  </Target>
</Project>
